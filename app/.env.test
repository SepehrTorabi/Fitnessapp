# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Tests must never reach the network or a real mail server. The null transport
# still records what was "sent", which is what the mailer assertions check.
MAILER_DSN=null://null

# Same database server as development, a separate database: doctrine.yaml adds
# the _test suffix, so this ends up as "app_test".
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
