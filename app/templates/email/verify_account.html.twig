{# Confirmation mail. Deliberately plain: table-free, inline styles only, and
   readable even if the client strips the CSS entirely. #}
<!DOCTYPE html>
<html lang="en">
<body style="margin:0;padding:24px;background:#f5f6f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2328;">
    <div style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;padding:32px;">
        <h1 style="margin:0 0 16px;font-size:20px;">Welcome, {{ displayName }}</h1>

        <p style="margin:0 0 16px;line-height:1.6;">
            Confirm your e-mail address to activate your Fitnessapp account.
        </p>

        <p style="margin:0 0 24px;">
            <a href="{{ verifyUrl }}"
               style="display:inline-block;background:#16a34a;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:600;">
                Confirm my address
            </a>
        </p>

        <p style="margin:0 0 16px;line-height:1.6;color:#57606a;font-size:14px;">
            The link is valid for {{ expiresInHours }} hours. If the button does not
            work, copy this address into your browser:
        </p>

        <p style="margin:0 0 24px;word-break:break-all;font-size:13px;color:#57606a;">
            {{ verifyUrl }}
        </p>

        <p style="margin:0;line-height:1.6;color:#57606a;font-size:13px;">
            If you did not create an account, you can ignore this message - without
            confirmation the address will not be used.
        </p>
    </div>
</body>
</html>
